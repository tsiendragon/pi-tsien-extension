{
  "name": "pi-tsien-extension",
  "version": "0.3.0",
  "description": "A collection of practical Pi extensions maintained by Tsien.",
  "type": "module",
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./extensions/*.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --import tsx --test test/*.test.ts test/integrated/zero/*.test.mjs test/integrated/memory/**/*.test.mjs",
    "test:vitest": "vitest run --config vitest.integrated.config.ts",
    "check": "npm run typecheck && npm test"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2",
    "@earendil-works/pi-coding-agent": ">=0.84.2",
    "@earendil-works/pi-tui": ">=0.84.2"
  },
  "dependencies": {
    "jiti": "^2.7.0",
    "pi-compact-thinking": "^0.2.0",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.84.2",
    "@earendil-works/pi-coding-agent": "^0.84.2",
    "@earendil-works/pi-tui": "^0.84.2",
    "@types/node": "^24.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  }
}
