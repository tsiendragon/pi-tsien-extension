{
  "name": "pi-tsien-extension",
  "version": "0.3.0",
  "description": "A collection of practical Pi extensions maintained by Tsien.",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "keywords": [
    "pi-package",
    "pi-extension"
  ],
  "engines": {
    "node": ">=22"
  },
  "pi": {
    "extensions": [
      "./packages/pi-tsien-web-tools/src/index.ts",
      "./packages/pi-tsien-rtk-fork/src/index.ts",
      "./packages/pi-tsien-session-ui-fork/src/index.ts",
      "./packages/pi-tsien-side-chat/src/index.ts",
      "./packages/pi-tsien-auto-compact/src/index.ts",
      "./packages/pi-tsien-compact-continue/src/index.ts",
      "./packages/pi-tsien-context-powerline/src/index.ts",
      "./packages/pi-tsien-default-system-prompt/src/index.ts",
      "./packages/pi-tsien-thinking-level/src/index.ts",
      "./packages/pi-tsien-git-graph/src/index.ts",
      "./packages/pi-tsien-goal/src/index.ts",
      "./packages/pi-tsien-live-session/src/index.ts",
      "./packages/pi-tsien-memory/src/extension/index.ts",
      "./packages/pi-tsien-metrics-sidebar/src/index.ts",
      "./packages/pi-tsien-code-mode/src/index.ts",
      "./packages/pi-tsien-running-commands/src/index.ts",
      "./packages/pi-tsien-schedule/src/index.ts",
      "./packages/pi-tsien-session-aliases/src/index.ts",
      "./packages/pi-tsien-sidebar/src/index.ts",
      "./packages/pi-tsien-subagent-workbench/src/index.ts",
      "./packages/pi-tsien-usage-analytics/src/index.ts",
      "./packages/pi-tsien-prompt-inspector/src/index.ts",
      "./packages/pi-tsien-observation-pack/src/index.ts",
      "./packages/pi-tsien-trajectory-recorder/src/index.ts",
      "./packages/pi-tsien-capability/src/index.ts"
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "npm run test:node && npm run test:vitest",
    "test:node": "node --import tsx --test test/*.test.ts test/integrated/zero/*.test.mjs test/integrated/memory/**/*.test.mjs packages/*/test/*.test.ts",
    "test:vitest": "vitest run --config vitest.integrated.config.ts",
    "parity:capture": "node --import tsx scripts/extension-parity.mjs --config config/extensions.standalone.json --out test/fixtures/extension-parity-baseline.json",
    "parity:check": "node --import tsx scripts/extension-parity.mjs --config config/extensions.standalone.json --baseline test/fixtures/extension-parity-baseline.json",
    "check": "npm run typecheck && npm test",
    "publish:packages": "node scripts/publish-packages.mjs",
    "publish:until-done": "node scripts/publish-until-done.mjs"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.84.2 <1.0.0 || ^0.85.1-tsien.1",
    "@earendil-works/pi-coding-agent": ">=0.84.2 <1.0.0 || ^0.85.1-tsien.1",
    "@earendil-works/pi-tui": ">=0.84.2 <1.0.0 || ^0.85.1-tsien.1"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "jiti": "^2.7.0",
    "jsdom": "^26.0.0",
    "pi-compact-thinking": "^0.2.0",
    "turndown": "^7.2.0",
    "turndown-plugin-gfm": "^1.0.2",
    "typebox": "^1.3.13"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "https://github.com/tsiendragon/pi/releases/download/v0.85.1-tsien.1/earendil-works-pi-ai-0.85.1-tsien.1.tgz",
    "@earendil-works/pi-coding-agent": "https://github.com/tsiendragon/pi/releases/download/v0.85.1-tsien.1/earendil-works-pi-coding-agent-0.85.1-tsien.1.tgz",
    "@earendil-works/pi-tui": "https://github.com/tsiendragon/pi/releases/download/v0.85.1-tsien.1/earendil-works-pi-tui-0.85.1-tsien.1.tgz",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/turndown": "^5.0.5",
    "tsx": "^4.23.12",
    "typescript": "^5.9.0",
    "vitest": "^4.1.11"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tsiendragon/pi-tsien-extension.git"
  },
  "homepage": "https://github.com/tsiendragon/pi-tsien-extension#readme",
  "author": "tsiendragon",
  "bugs": {
    "url": "https://github.com/tsiendragon/pi-tsien-extension/issues"
  }
}
